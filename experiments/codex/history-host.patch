+//! Debug-only request-copy adapter. No persisted history or authentication changes.
+use codex_protocol::models::{ContentItem, ImageReference, ResponseItem};
+use serde::Deserialize;
+use sha2::{Digest, Sha256};
+use std::collections::HashSet;
+use std::io::Write;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Replacement { ordinal: usize, expected_sha256: String, reference: String }
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Plan { generation: String, expected_images: usize, replacements: Vec<Replacement> }
+
+pub(crate) fn transform(input: &mut [ResponseItem]) -> Result<(), String> {
+    if !cfg!(debug_assertions) { return Ok(()); }
+    let Some(path) = std::env::var_os("ICM_EXPERIMENT_HISTORY_PLAN") else { return Ok(()); };
+    let start = std::time::Instant::now();
+    let plan: Plan = serde_json::from_slice(&std::fs::read(&path).map_err(|e| e.to_string())?).map_err(|e| e.to_string())?;
+    let mut before = Vec::new();
+    for item in input.iter() {
+        if let ResponseItem::Message { content, .. } = item {
+            for c in content {
+                if let ContentItem::InputImage { image, .. } = c {
+                    match image {
+                        ImageReference::Inline { image_url } => before.push((format!("{:x}", Sha256::digest(image_url.as_bytes())), image_url.len())),
+                        _ => return Err("ICM experiment requires inline images".into()),
+                    }
+                }
+            }
+        }
+    }
+    if before.len() != plan.expected_images { return Err("ICM image count mismatch; refusing request".into()); }
+    let mut targets = HashSet::new();
+    for r in &plan.replacements {
+        if !targets.insert(r.ordinal) || r.reference.is_empty() || before.get(r.ordinal).map(|v| &v.0) != Some(&r.expected_sha256) {
+            return Err("ICM replacement source/ordinal mismatch; refusing request".into());
+        }
+    }
+    // Validate the entire plan before mutating any item. Current images are excluded by the planner.
+    let mut ordinal = 0;
+    let mut kept = Vec::new();
+    for item in input.iter_mut() {
+        if let ResponseItem::Message { content, .. } = item {
+            for c in content {
+                if matches!(c, ContentItem::InputImage { .. }) {
+                    if let Some(r) = plan.replacements.iter().find(|r| r.ordinal == ordinal) {
+                        *c = ContentItem::InputText { text: r.reference.clone() };
+                    } else { kept.push(ordinal); }
+                    ordinal += 1;
+                }
+            }
+        }
+    }
+    let audit = serde_json::json!({"generation": plan.generation, "before_image_count": before.len(),
+        "before_images": before.iter().enumerate().map(|(i,(hash,bytes))|serde_json::json!({"ordinal":i,"url_sha256":hash,"url_bytes":bytes})).collect::<Vec<_>>(),
+        "replaced_ordinals": plan.replacements.iter().map(|r|r.ordinal).collect::<Vec<_>>(),
+        "kept_ordinals": kept, "after_image_count": kept.len(),
+        "after_image_url_bytes": kept.iter().map(|i|before[*i].1).sum::<usize>(),
+        "transform_duration_us":start.elapsed().as_micros(), "request_copy_only":true});
+    let mut audit_path = std::path::PathBuf::from(path);
+    audit_path.set_extension("audit.jsonl");
+    let mut file = std::fs::OpenOptions::new().create(true).append(true).open(audit_path).map_err(|e|e.to_string())?;
+    writeln!(file,"{}",audit).map_err(|e|e.to_string())?;
+    Ok(())
+}
